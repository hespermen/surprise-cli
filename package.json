{
  "name": "surprise-cli",
  "version": "0.2.0",
  "description": "SURPRISE.FM в терминале: эфир, архив выпусков и своя библиотека",
  "type": "module",
  "bin": {
    "surprise": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "dev": "node --experimental-strip-types src/index.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "esbuild": "^0.28.1",
    "ink": "^5.1.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "typescript": "^5.6.3"
  },
  "license": "MIT",
  "author": "Private Persons",
  "keywords": [
    "surprise.fm",
    "radio",
    "music",
    "cli",
    "tui",
    "terminal",
    "player",
    "mpv"
  ],
  "homepage": "https://surprise.fm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hespermen/surprise-cli.git"
  },
  "bugs": {
    "url": "https://github.com/hespermen/surprise-cli/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
